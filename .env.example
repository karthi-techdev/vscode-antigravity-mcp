# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Multi-Tenant Auth
# Pre-shared admin secret for generating or registering new user keys (optional)
ADMIN_SECRET_KEY=change_this_admin_secret_in_production

# User API keys and IDs: comma-separated list of "token:user_id" pairs for simple static deployments,
# or leave empty if using dynamic token verification
AUTH_TOKENS=user_alice_secret_token:alice,user_bob_secret_token:bob

# Upstash Redis (Optional - for production multi-instance serverless on Vercel)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Client Configuration (for local machine)
MCP_SERVER_URL=http://localhost:8000
MCP_AUTH_TOKEN=user_alice_secret_token
MCP_WORKSPACE_DIR=.
