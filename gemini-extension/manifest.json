{
  "manifest_version": 3,
  "name": "Gemini IDE Remote Bridge",
  "version": "1.0.0",
  "description": "Enables gemini.google.com to execute local IDE actions & file tools directly.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://vscode-antigravity-mcp.vercel.app/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini IDE Bridge Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
